# ============================================
# KOKORIKO IA - Configuration environnement
# ============================================

# Base de données MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=kokoriko_db

# Sécurité JWT (CHANGER EN PRODUCTION!)
SECRET_KEY=kokoriko-secret-change-me-2024-burkina
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Intelligence Artificielle
# Choisir: "openai" ou "gemini"
AI_PROVIDER=openai
OPENAI_API_KEY=sk-votre-cle-openai-ici
GEMINI_API_KEY=votre-cle-gemini-ici

# Serveur
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Upload fichiers
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
